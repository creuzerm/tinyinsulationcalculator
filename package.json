{
  "name": "app",
  "version": "1.0.0",
  "description": "This project is an exploration tool designed to estimate the heating load and passive thermal performance of small structures (Tiny Homes, Sheds, Cabins). Unlike simple R-value calculators, this tool integrates **Thermal Mass (The \"Battery\")** and **Passive Simulation** to visualize how a building behaves over time without supplemental heating.",
  "main": "calculator.js",
  "scripts": {
    "test": "jest",
    "mcp:start": "tsx mcp-server/index.ts",
    "mcp:build": "tsc -p mcp-server/tsconfig.json",
    "mcp:test": "jest mcp-server/mcp_server.test.ts"
  },
